generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

// Only the app's own schema is managed here. Supabase owns the `auth` schema;
// public.profiles.id -> auth.users.id (ON DELETE CASCADE) exists in the database
// but is intentionally not modelled. Do NOT run `prisma db push` (it would drop
// that foreign key); apply schema changes with SQL files in prisma/sql/.
datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model dividends {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String        @db.Uuid
  stock_id       String?       @db.Uuid
  type           dividend_type
  year           Int
  percentage     Decimal?      @db.Decimal
  cash_amount    Decimal?      @db.Decimal
  bonus_quantity Decimal?      @db.Decimal
  date           DateTime      @db.Date
  note           String?
  created_at     DateTime?     @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  stocks         stocks?       @relation(fields: [stock_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles       profiles      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
  @@index([stock_id])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model dse_companies {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  symbol        String    @unique
  company_name  String
  category      String?
  sector        String?
  address       String?
  phone         String?
  email         String?
  current_price Decimal?  @db.Decimal
  updated_at    DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @updatedAt @db.Timestamptz(6)
  created_at    DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  // Relation to user portfolio stocks
  stocks          stocks[]
  shortTermTrades short_term_trades[]

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profiles {
  id              String              @id @db.Uuid
  full_name       String?
  email           String?
  phone           String?
  address         String?
  avatar_url      String?
  created_at      DateTime?           @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at      DateTime?           @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  dividends       dividends[]
  stocks          stocks[]
  transactions    transactions[]
  watchlist       watchlist[]
  price_alerts    price_alerts[]
  shortTermTrades short_term_trades[]

  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model stocks {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  symbol  String

  // Relation to master company data
  dse_company dse_companies @relation(fields: [symbol], references: [symbol])

  face_value Decimal? @default(10) @db.Decimal

  // Portfolio Aggregates
  total_quantity    Decimal? @default(0) @db.Decimal
  total_investment  Decimal? @default(0) @db.Decimal
  average_buy_price Decimal? @default(0) @db.Decimal
  portfolio_price   Decimal? @default(0) @db.Decimal

  created_at   DateTime?      @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at   DateTime?      @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  dividends    dividends[]
  profiles     profiles       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transactions transactions[]

  @@unique([user_id, symbol])
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model transactions {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String           @db.Uuid
  stock_id         String?          @db.Uuid
  type             transaction_type
  quantity         Decimal          @db.Decimal
  price_per_unit   Decimal          @db.Decimal
  transaction_date DateTime         @db.Date
  brokerage_fee    Decimal?         @db.Decimal
  note             String?
  created_at       DateTime?        @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  stocks           stocks?          @relation(fields: [stock_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles         profiles         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, transaction_date])
  @@index([stock_id])
  @@schema("public")
}

/// User's watchlist of DSE stocks
model watchlist {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  symbol     String
  created_at DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  profiles   profiles  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, symbol])
  @@schema("public")
}

/// Price alert ranges for buy/sell
model price_alerts {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String    @db.Uuid
  symbol            String
  buy_min_price     Decimal?  @db.Decimal
  buy_max_price     Decimal?  @db.Decimal
  sell_min_price    Decimal?  @db.Decimal
  sell_max_price    Decimal?  @db.Decimal
  is_buy_triggered  Boolean   @default(false)
  is_sell_triggered Boolean   @default(false)
  created_at        DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  profiles          profiles  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, symbol])
  @@schema("public")
}

enum dividend_type {
  INTERIM
  FINAL

  @@schema("public")
}

enum transaction_type {
  BUY
  SELL

  @@schema("public")
}

enum short_term_trade_status {
  OPEN
  CLOSED

  @@schema("public")
}

model short_term_trades {
  id      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String                  @db.Uuid
  symbol  String
  status  short_term_trade_status @default(OPEN)

  total_buy_qty      Decimal @default(0) @db.Decimal
  total_sell_qty     Decimal @default(0) @db.Decimal
  average_buy_price  Decimal @default(0) @db.Decimal
  average_sell_price Decimal @default(0) @db.Decimal
  realized_profit    Decimal @default(0) @db.Decimal

  opened_at DateTime  @default(now()) @db.Date
  closed_at DateTime? @db.Date

  legs        short_term_trade_legs[]
  dse_company dse_companies           @relation(fields: [symbol], references: [symbol])
  profiles    profiles                @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, symbol, status])
  @@schema("public")
}

model short_term_trade_legs {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trade_id       String           @db.Uuid
  type           transaction_type
  quantity       Decimal          @db.Decimal
  price_per_unit Decimal          @db.Decimal
  brokerage_fee  Decimal          @default(0) @db.Decimal
  date           DateTime         @db.Date
  created_at     DateTime?        @default(now())

  trade short_term_trades @relation(fields: [trade_id], references: [id], onDelete: Cascade)

  @@index([trade_id])
  @@schema("public")
}
